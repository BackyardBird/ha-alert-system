# Comprehensive Test Suite for Alert System v6.0
# Run these tests one by one and verify results in Telegram groups
#
# SETUP: Replace example entity IDs with actual entities from your system:
# - sensor.living_room_temperature (assigned to "Living Room" area)
# - binary_sensor.front_door (assigned to "Front Entrance" area)
# - sensor.cpu_temperature (assigned to "Server Room" area)
# - sensor.uptime (not assigned to any area)

# ===== PHASE 1: SYSTEM CONNECTIVITY =====

# Test 1: System Test (Both Channels)
action: script.test_alert
data:
  channel: "both"
# Expected: Identical messages in BOTH groups

# ===== PHASE 2: CORE SCRIPT TESTING =====

# Test 2: Send Alert - Main Channel
action: script.send_alert
data:
  message: "Main channel test"
  level: "info"
  channel: "main"
# Expected: Message ONLY in main group

# Test 3: Send Alert - Technical Channel
action: script.send_alert
data:
  message: "Technical channel test"
  level: "info"
  channel: "technical"
# Expected: Message ONLY in technical group

# Test 4: Send Alert - Both Channels
action: script.send_alert
data:
  message: "Both channels test"
  level: "info"
  channel: "both"
# Expected: Identical messages in BOTH groups

# Test 5: System Alert (Default: Technical)
action: script.system_alert
data:
  message: "System alert test"
  level: "warning"
# Expected: Message ONLY in technical group with "SYSTEM:" prefix

# Test 6: System Alert Override to Main
action: script.system_alert
data:
  message: "System alert override to main"
  level: "warning"
  channel: "main"
# Expected: Message ONLY in main group with "SYSTEM:" prefix

# Test 7: Security Alert (Always Both)
action: script.security_alert
data:
  message: "Security test"
  location: "Front Door"
# Expected: Messages in BOTH groups with "SECURITY:" prefix, critical level, ">> Front Door"

# ===== PHASE 3: ALERT LEVELS =====

# Test 8: Info Level
action: script.send_alert
data:
  message: "Info level test"
  level: "info"
  channel: "both"
# Expected: INFO in header

# Test 9: Warning Level
action: script.send_alert
data:
  message: "Warning level test"
  level: "warning"
  channel: "both"
# Expected: WARNING in header

# Test 10: Critical Level
action: script.send_alert
data:
  message: "Critical level test"
  level: "critical"
  channel: "both"
# Expected: CRITICAL in header

# ===== PHASE 4: FORMATTING AND FEATURES =====

# Test 11: Timestamp Toggle
action: script.send_alert
data:
  message: "No timestamp test"
  level: "info"
  channel: "both"
  include_timestamp: false
# Expected: No timestamp in header

# Test 12: Manual Location
action: script.send_alert
data:
  message: "Manual location test"
  level: "info"
  channel: "both"
  location: "Test Location"
# Expected: ">> Test Location" on separate line

# Test 13: HTML Formatting
action: script.send_alert
data:
  message: "HTML test with <b>bold</b> and <i>italic</i> text"
  level: "info"
  channel: "both"
# Expected: Bold and italic formatting works

# ===== PHASE 5: BULK ALERTS =====

# Test 14: Mixed Channel Bulk Alert
action: script.bulk_alert
data:
  alerts:
    - message: "Bulk test 1 - main"
      level: "info"
      channel: "main"
    - message: "Bulk test 2 - technical"
      level: "warning"
      channel: "technical"
    - message: "Bulk test 3 - both"
      level: "critical"
      channel: "both"
      location: "Test Location"
# Expected:
# - Message 1 ONLY in main
# - Message 2 ONLY in technical
# - Message 3 in BOTH with ">> Test Location"

# ===== PHASE 6: EDGE CASES =====

# Test 15: Empty Location
action: script.send_alert
data:
  message: "Empty location test"
  level: "info"
  channel: "both"
  location: ""
# Expected: No location line shown

# Test 16: Long Message
action: script.send_alert
data:
  message: "This is a very long message to test how the formatting handles extended text that might wrap across multiple lines in the Telegram interface and ensure proper formatting is maintained throughout the entire message length"
  level: "info"
  channel: "both"
  location: "Very Long Location Name That Tests Formatting"
# Expected: Proper formatting maintained

# Test 17: Special Characters
action: script.send_alert
data:
  message: "Special chars: !@#$%^&*()_+-=[]{}|;':\",./<>?"
  level: "info"
  channel: "both"
# Expected: All characters display correctly

# Test 18: Override Chat ID (Direct Targeting)
action: script.send_alert
data:
  message: "Direct chat ID override test"
  level: "info"
  chat_id: "-1001234567890"  # Replace with actual main channel Chat ID
# Expected: Message ONLY in targeted group

# Test 19: Invalid Channel (Should Fallback to Technical)
action: script.send_alert
data:
  message: "Invalid channel test"
  level: "info"
  channel: "invalid_channel_name"
# Expected: Fallback message in technical channel

# ===== PHASE 7: AUTOMATIC LOCATION DETECTION =====

# Test 20: Auto-Location - Entity with Area
action: script.send_alert
data:
  message: "Auto-location test"
  level: "info"
  channel: "both"
  entity_id: "sensor.living_room_temperature"  # Replace with entity assigned to area
# Expected: ">> Living Room" (or whatever area the entity is assigned to)

# Test 21: Manual Location Override
action: script.send_alert
data:
  message: "Manual override test"
  level: "info"
  channel: "both"
  entity_id: "sensor.living_room_temperature"
  location: "Custom Override"
# Expected: ">> Custom Override" (manual takes priority)

# Test 22: Entity Without Area
action: script.send_alert
data:
  message: "Entity without area test"
  level: "info"
  channel: "both"
  entity_id: "sensor.uptime"  # Entity not assigned to area
# Expected: No location line, no errors

# Test 23: Invalid Entity ID
action: script.send_alert
data:
  message: "Invalid entity test"
  level: "info"
  channel: "both"
  entity_id: "sensor.nonexistent_sensor"
# Expected: No location line, no errors

# Test 24: Empty Entity ID
action: script.send_alert
data:
  message: "Empty entity_id test"
  level: "info"
  channel: "both"
  entity_id: ""
# Expected: No location line, no errors

# ===== PHASE 8: THRESHOLD SYSTEM =====

# Test 25: Add Threshold Alert
action: script.add_threshold_alert
data:
  entity_id: "sensor.living_room_temperature"
  threshold: "25"
  condition: "above"
  offline_min: "10"
# Expected: Confirmation in technical channel

# Test 26: Add Offline-Only Monitoring
action: script.add_threshold_alert
data:
  entity_id: "sensor.garage_door"
  offline_min: "5"
# Expected: Confirmation mentioning "offline only"

# Test 27: List All Alerts
action: script.list_threshold_alerts
# Expected: Human-readable list in technical channel with friendly names,
#           conditions, thresholds, and offline delays

# Test 28: Remove Threshold Alert
action: script.remove_threshold_alert
data:
  entity_id: "sensor.living_room_temperature"
# Expected: Confirmation in technical channel

# Test 29: Test Threshold System
action: script.test_threshold_alert
# Expected: Test message sent to configured channel

# Test 30: Clear All Alerts
action: script.clear_all_threshold_alerts
# Expected: Confirmation in technical channel

# Test 31: Create Alert from Form
# Use the dashboard form:
# 1. Enter entity ID in the form
# 2. Set threshold value and condition (or select "offline only")
# 3. Optionally set offline delay
# 4. Click "Create Alert"
# Expected: Alert created, form cleared, confirmation in technical channel

# ===== PHASE 9: THRESHOLD ALERT TRIGGERING =====
# NOTE: These require actual sensor entities and configured threshold alerts

# Test 32: Threshold Breach
# Prerequisites: Configure a threshold alert, then change sensor value to cross it
# Expected: Auto-generated message like "Living Room Temperature is above 25 C"
#           followed by "Current value: 27 C"
#           with auto-detected location

# Test 33: Device Offline
# Prerequisites: Entity in threshold list goes unavailable
# Expected: After configured delay: "DEVICE OFFLINE: {name} has been unavailable for X minutes"

# Test 34: Device Online
# Prerequisites: Previously offline entity comes back
# Expected: Immediate "DEVICE ONLINE: {name} is back online (value unit)"

# ===== PHASE 10: BLUEPRINT TESTING =====

# Test 35: Create Automation via Blueprint
# 1. Go to Settings > Automations > Create Automation > Use Blueprint
# 2. Select "Send Alert on Entity State Change"
# 3. Fill in all fields (entity, trigger state, message, level, channel)
# 4. Save and enable the automation
# 5. Trigger the entity state change
# Expected: Alert sent with correct message, level, channel, and auto-location

# ===== VERIFICATION CHECKLIST =====

# CORE FUNCTIONALITY
# - All 5 scripts work (send_alert, system_alert, security_alert, bulk_alert, test_alert)
# - Channel routing works correctly (main/technical/both)
# - Alert levels display correctly (INFO/WARNING/CRITICAL)
